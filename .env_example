# Contact form endpoint. Cloudflare Pages serves this from functions/api/send-inquiry.ts.
PUBLIC_INQUIRY_ENDPOINT=/api/send-inquiry

# Fallback recipient for client-side mailto submission.
PUBLIC_INQUIRY_EMAIL=info@decosupplier.com

# Configure these in Cloudflare Pages environment variables, not in browser code:
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=
# RESEND_TO_EMAIL=
# RESEND_REPLY_TO_EMAIL=

# NocoBase API base URL for the deco_category collection.
NOCObase_API_BASE_URL=

# NocoBase read-only API token. Add the token here before testing the category menu.
NOCObase_API_TOKEN=
