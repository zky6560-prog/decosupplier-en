---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/ui/Section.astro';
import Card from '../components/ui/Card.astro';
import Button from '../components/ui/Button.astro';
import { Image } from 'astro:assets';
import ImageReveal from '../components/react/ImageReveal';

// 背景图片
import heroBgImg from '@assets/productlines.png';
import ctaBgImg from '@assets/photo-1553413077-190dd305871c.jpg';
import photoPlaceholder from '@assets/photo-1581091226825-a6a2a5aee158.jpg';
import printingLineImg from '@assets/printingline.png';

// 设备产能卡片图片
import gravurePrintingImg from '@assets/high-speed-gravure-printing-lines.png';
import embossingLaminationImg from '@assets/embossing-and-lamination-lines.png';
import adhesiveCoatingImg from '@assets/adhesive-coating-equipment.jpg';
import slittingPackagingImg from '@assets/automated-slitting-and-packaging-lines.png';

// ===== 设备产能卡片数据（4个，沿用原设施卡片结构） =====
const equipment = [
  {
    name: 'High-Speed Gravure Printing Lines',
    type: 'Core Equipment',
    location: 'Huangshan, Anhui',
    size: 'Multi-color registration',
    image: gravurePrintingImg,
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h2a2 2 0 012 2m0 10a2 2 0 002 2h2a2 2 0 002-2M9 7a2 2 0 012-2h2a2 2 0 012 2m0 10V7m0 10a2 2 0 002 2h2a2 2 0 002-2V7a2 2 0 00-2-2h-2a2 2 0 00-2 2" />
    </svg>`,
    features: [
      'Multi-color registration capability',
      'High precision, minimal color deviation',
      'Suitable for decorative film & flooring',
      'Continuous high-speed operation',
      'Consistent pattern repeat accuracy'
    ],
    certifications: ['ISO 9001', 'CE Certified']
  },
  {
    name: 'Embossing & Lamination Lines',
    type: 'Core Equipment',
    location: 'Huangshan, Anhui',
    size: 'Precise grain alignment',
    image: embossingLaminationImg,
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h4a1 1 0 011 1v7a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM14 5a1 1 0 011-1h4a1 1 0 011 1v7a1 1 0 01-1 1h-4a1 1 0 01-1-1V5zM4 16a1 1 0 011-1h4a1 1 0 011 1v3a1 1 0 01-1 1H5a1 1 0 01-1-1v-3zM14 16a1 1 0 011-1h4a1 1 0 011 1v3a1 1 0 01-1 1h-4a1 1 0 01-1-1v-3z" />
    </svg>`,
    features: [
      'Precise grain alignment with printed patterns',
      'Hot-press & cold-press options',
      'Multiple texture depth levels',
      'Suitable for wall panels & flooring',
      'Consistent surface finish across batches'
    ],
    certifications: ['ISO 9001', 'ISO 14001']
  },
  {
    name: 'Adhesive Coating Equipment',
    type: 'Core Equipment',
    location: 'Huangshan, Anhui',
    size: 'Scaled production',
    image: adhesiveCoatingImg,
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
    </svg>`,
    features: [
      'Scaled production of self-adhesive products',
      'Uniform adhesive layer thickness',
      'High bonding strength QC',
      'Suitable for peel-and-stick series',
      'Low VOC, eco-friendly adhesive'
    ],
    certifications: ['ISO 9001', 'REACH Compliant']
  },
  {
    name: 'Automated Slitting & Packaging Lines',
    type: 'Core Equipment',
    location: 'Huangshan, Anhui',
    size: 'Efficient delivery',
    image: slittingPackagingImg,
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
    </svg>`,
    features: [
      'Automated precision slitting',
      'Custom roll widths & lengths',
      'Protective packaging for export',
      'Barcode & label application',
      'Container-ready pallet loading'
    ],
    certifications: ['ISO 9001', 'AEO']
  }
];

// ===== 为什么选择（6个理由） =====
const reasons = [
  {
    title: "Factory-Direct Pricing",
    description: "No middlemen, no brand markup. You pay for the material itself — not layers of distribution costs.",
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
    </svg>`,
    color: "from-blue-500 to-blue-600"
  },
  {
    title: "Full Product Range",
    description: "From films to flooring to wall panels — seven product lines available for one-stop sourcing. Color-matched across categories, no need to piece together from multiple suppliers.",
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6z M14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6z M4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2z M14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
    </svg>`,
    color: "from-teal-500 to-teal-600"
  },
  {
    title: "In-House Print Cylinders",
    description: "1000+ patterns, all with cylinders owned in-house. No reliance on external plate-makers. Faster turnaround on pattern changes, reorders, and new designs.",
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
    </svg>`,
    color: "from-purple-500 to-purple-600"
  },
  {
    title: "Customization Flexibility",
    description: "Sample-based or design-based customization, OEM/ODM private labeling all supported. Cylinder engraving costs are deductible from bulk order payments — lowering your startup investment.",
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
    </svg>`,
    color: "from-orange-500 to-orange-600"
  },
  {
    title: "Communication & Delivery",
    description: "FOB from major Chinese ports (Ningbo/Shanghai/Yiwu/Xinjiang) with stable lead times. Direct export team communication — no middlemen, no language barriers.",
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
    </svg>`,
    color: "from-cyan-500 to-cyan-600"
  },
  {
    title: "Value-Added Services",
    description: "Real-time order status syncing via API (connect to your procurement system) and initial trademark & patent risk screening consultation — making cross-border sourcing more secure.",
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
    </svg>`,
    color: "from-emerald-500 to-emerald-600"
  }
];

// ===== 价值观（5条） =====
const values = [
  {
    text: "Factory-direct quality cuts 20-40% off your landed cost.",
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
    </svg>`
  },
  {
    text: "Factories should be transparent, not guarded.",
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
    </svg>`
  },
  {
    text: "Every inquiry is the start of a trust relationship.",
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
    </svg>`
  },
  {
    text: "Long-term partnership beats a one-off deal.",
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
    </svg>`
  },
  {
    text: "Chinese manufacturing, global standards — ISO 9001 compliant.",
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
    </svg>`
  },
  {
    text: "10+ years of expertise, 52 patents — a mature, reliable manufacturing partner.",
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
    </svg>`
  }
];
---

<BaseLayout
  title="About DecoSupplier - PVC Film, LVT & Wall Panel Manufacturer from China"
  description="Not traders. A factory team with 15+ years in PVC film manufacturing, 52 patents, serving 30+ countries across Middle East, Central Asia, Southeast Asia, South America, Russia, Ukraine, and Africa."
>
  
  <!-- ===== HERO SECTION（已调整为 Blog 横幅排布样式，蒙版 +10% 至 /20） ===== -->
  <section class="relative py-16 md:py-24 overflow-hidden bg-slate-200">
    <div class="absolute inset-0">
      <Image 
        src={heroBgImg}
        alt="DecoSupplier factory and manufacturing facility"
        class="w-full h-full object-cover"
        width={1920}
        height={600}
        loading="eager"
        fetchpriority="high"
        onerror="this.style.display='none'"
      />
      <!-- 蒙版不透明度 -->
      <div class="absolute inset-0 bg-linear-to-r from-slate-700/50 via-slate-700/50 to-slate-700/10"></div>
    </div>
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-4xl">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-4">
          From One Printing Line to a <span class="text-transparent bg-clip-text bg-linear-to-r from-[var(--color-primary-400)] via-[var(--color-secondary-400)] to-[var(--color-primary-400)]">50,000 m² Factory</span>
        </h1>
        <p class="text-lg md:text-xl text-slate-200 max-w-2xl leading-relaxed">
          Not traders. A factory team with 15+ years in PVC film manufacturing, 52 patents, serving 30+ countries.
        </p>
        <p class="text-base text-slate-300 mt-2 max-w-xl leading-relaxed">
          We manufacture from printing and coating to finishing and packing, with a focus on stable quality, practical customization, and dependable production support.
        </p>
        <div class="mt-6">
          <a href="/products" class="inline-flex items-center px-6 py-3 text-base font-semibold text-white bg-linear-to-r from-[var(--color-primary-600)] to-[var(--color-secondary-600)] hover:from-[var(--color-primary-700)] hover:to-[var(--color-secondary-700)] rounded-lg shadow-lg hover:shadow-xl transition-all group">
            View Our Products
            <svg class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== TRUST DATA (大数字) ===== -->
  <Section background="white">
    <div class="text-center mb-16">
      <div class="inline-block px-4 py-2 mb-4 bg-[color:var(--color-primary-100)] text-[color:var(--color-primary-800)] text-sm font-semibold rounded-full">
        The Numbers Behind Our Confidence
      </div>
      <h2 class="text-4xl md:text-5xl font-bold text-slate-900 mb-4">
        Built on <span class="text-transparent bg-clip-text bg-linear-to-r from-[var(--color-primary-600)] to-[var(--color-secondary-600)]">Trust &amp; Track Record</span>
      </h2>
      <p class="text-xl text-slate-600 max-w-3xl mx-auto leading-relaxed">
        Decades of experience, thousands of patterns, and massive capacity — these are the numbers that back every roll we ship.
      </p>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 max-w-4xl mx-auto text-center">
      <div class="group">
        <div class="text-5xl md:text-6xl font-bold text-transparent bg-clip-text bg-linear-to-r from-blue-600 to-teal-600 mb-2 group-hover:scale-110 transition-transform">15+</div>
        <div class="text-sm text-slate-500">Years of Manufacturing &amp; Export</div>
      </div>
      <div class="group">
        <div class="text-5xl md:text-6xl font-bold text-transparent bg-clip-text bg-linear-to-r from-blue-600 to-teal-600 mb-2 group-hover:scale-110 transition-transform">1000+</div>
        <div class="text-sm text-slate-500">Print Cylinders in Stock</div>
      </div>
      <div class="group">
        <div class="text-5xl md:text-6xl font-bold text-transparent bg-clip-text bg-linear-to-r from-blue-600 to-teal-600 mb-2 group-hover:scale-110 transition-transform">5M+</div>
        <div class="text-sm text-slate-500">Monthly Production Capacity (sqm)</div>
      </div>
      <div class="group">
        <div class="text-5xl md:text-6xl font-bold text-transparent bg-clip-text bg-linear-to-r from-blue-600 to-teal-600 mb-2 group-hover:scale-110 transition-transform">7</div>
        <div class="text-sm text-slate-500">Core Product Lines</div>
      </div>
    </div>
  </Section>

  <!-- ===== ORIGIN & MISSION (左图右文) ===== -->
  <Section background="gray">
    <div class="max-w-6xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div class="order-1 lg:order-1">
          <div class="relative h-full min-h-[400px] rounded-2xl overflow-hidden shadow-xl">
            <Image 
              src={printingLineImg}
              alt="DecoSupplier early printing line and factory"
              class="w-full h-full object-cover"
              width={800}
              height={600}
              loading="lazy"
            />
            <div class="absolute inset-0 bg-linear-to-t from-slate-900/20 to-transparent"></div>
          </div>
        </div>
        <div class="order-2 lg:order-2">
          <div class="text-center lg:text-left mb-6">
            <div class="inline-block px-4 py-2 mb-4 bg-[color:var(--color-secondary-100)] text-[color:var(--color-secondary-800)] text-sm font-semibold rounded-full">
              Our Story
            </div>
            <h2 class="text-4xl md:text-5xl font-bold text-slate-900">
              15 Years, <span class="text-transparent bg-clip-text bg-linear-to-r from-[var(--color-primary-600)] to-[var(--color-secondary-600)]">One Focus</span>
            </h2>
          </div>
          <div class="prose prose-lg max-w-none text-slate-600 leading-relaxed space-y-4">
            <p>
              In 2010, a small team of PVC technicians built a factory to sell directly to overseas buyers — no middlemen, no inflated pricing, just quality materials at fair factory rates.
            </p>
            <p class="text-xl font-semibold text-slate-800 border-l-4 border-[var(--color-secondary-500)] pl-6">
              We don't trade. We don't represent brands. We manufacture —from single-category PVC film to seven product lines covering flooring, wall panels, and refinishing films — we stay committed to one thing: <span class="text-transparent bg-clip-text bg-linear-to-r from-[var(--color-primary-600)] to-[var(--color-secondary-600)]">helping global buyers get quality materials at a fair price, directly from the source.</span>
            </p>
          </div>
        </div>
      </div>
    </div>
  </Section>

  <!-- ===== EQUIPMENT & CAPACITY (4个设备卡片，沿用原设施卡片布局) ===== -->
  <Section background="white">
    <div class="text-center mb-12">
      <div class="inline-block px-4 py-2 mb-4 bg-blue-100 text-blue-800 text-sm font-semibold rounded-full">
        Equipment &amp; Capacity
      </div>
      <h2 class="text-4xl md:text-5xl font-bold text-slate-900 mb-4">
        Quality Built Into <span class="text-transparent bg-clip-text bg-linear-to-r from-blue-600 to-teal-600">Every Meter</span>
      </h2>
      <p class="text-xl text-slate-600 max-w-3xl mx-auto leading-relaxed">
        Our manufacturing base spans tens of thousands of square meters. Core equipment includes:
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {equipment.map((item, index) => (
        <Card hover class="overflow-hidden group" key={index}>
          <div class="relative h-56 overflow-hidden">
            <Image 
              src={item.image}
              alt={item.name}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              width={800}
              height={400}
              loading="lazy"
            />
            <div class="absolute inset-0 bg-linear-to-t from-slate-900/80 via-slate-900/40 to-transparent"></div>
            <div class="absolute top-4 right-4 w-12 h-12 rounded-full bg-white/90 backdrop-blur-sm flex items-center justify-center shadow-lg">
              <div class="w-6 h-6 text-blue-600" set:html={item.icon}></div>
            </div>
            <div class="absolute bottom-0 left-0 right-0 p-5 text-white">
              <h3 class="text-xl font-bold">{item.name}</h3>
              <p class="text-sm text-slate-200">{item.type}</p>
            </div>
          </div>
          <div class="p-6 space-y-4">
            <div class="flex flex-wrap items-center gap-3 text-sm text-slate-600">
              <span class="flex items-center gap-1">
                <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                {item.location}
              </span>
              <span class="text-slate-300">•</span>
              <span class="flex items-center gap-1">
                <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h4a1 1 0 011 1v7a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM14 5a1 1 0 011-1h4a1 1 0 011 1v7a1 1 0 01-1 1h-4a1 1 0 01-1-1V5zM4 16a1 1 0 011-1h4a1 1 0 011 1v3a1 1 0 01-1 1H5a1 1 0 01-1-1v-3zM14 16a1 1 0 011-1h4a1 1 0 011 1v3a1 1 0 01-1 1h-4a1 1 0 01-1-1v-3z" />
                </svg>
                {item.size}
              </span>
            </div>

            <div>
              <h4 class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">Key Features</h4>
              <ul class="grid grid-cols-1 gap-1.5">
                {item.features.map((feature, i) => (
                  <li class="flex items-start gap-2 text-sm text-slate-600" key={i}>
                    <svg class="w-4 h-4 text-teal-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    {feature}
                  </li>
