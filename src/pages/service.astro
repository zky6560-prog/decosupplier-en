---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/ui/Section.astro';
import Card from '../components/ui/Card.astro';
import Button from '../components/ui/Button.astro';
import { Image } from 'astro:assets';
import ImageReveal from '../components/react/ImageReveal';

// 背景图片与占位
import heroBgImg from '@assets/from-printing-to-finished-product.png';
import ctaBgImg from '@assets/photo-1553413077-190dd305871c.jpg';
import photoPlaceholder from '@assets/photo-1581091226825-a6a2a5aee158.jpg';

// 7个产品图片
import pvcFilmImg from '@assets/pvc-decorative-film.jpg';
import lvtFlooringImg from '@assets/lvt-flooring.jpg';
import pvcPanelImg from '@assets/pvc-wall-panel.jpg';
import selfAdhesiveFilmImg from '@assets/interior-self-adhesive-film.jpg';
import foamWallpaperImg from '@assets/self-adhesive-foam-wall-roll.png';
import pvc3dImg from '@assets/3d-pvc-wall-panel.jpg';
import wallpapersImg from '@assets/peel-stick-wallpapers.png';

// ===== 模块2：三大服务支柱（大幅精简描述） =====
const servicePillars = [
  {
    title: "Direct Manufacturing & Full Category Matching",
    description: "3 in-house factories covering 7 product categories. One-stop sourcing with perfectly matched patterns across films, floors, and wall panels.",
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" /></svg>`,
    color: "from-[var(--color-primary-500)] to-[var(--color-primary-600)]"
  },
  {
    title: "Flexible OEM/ODM Customization",
    description: "Supports sample/design-based customization & private labeling. 1000+ in-house cylinders for fast development. We also offer IP infringement risk assessment for target markets.",
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" /></svg>`,
    color: "from-[var(--color-secondary-500)] to-[var(--color-secondary-600)]"
  },
  {
    title: "Digital Delivery & Order Sync",
    description: "Real-time API integration with your CRM/ERP. Production progress and inventory sync automatically, making global procurement totally transparent and efficient.",
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" /></svg>`,
    color: "from-[var(--color-primary-500)] to-[var(--color-primary-600)]"
  }
];

// ===== 模块3：8步定制流程 =====
const steps = [
  { num: "01", title: "Pattern or Sample Request", desc: "Provide your reference patterns, target price, or physical samples." },
  { num: "02", title: "IP Compliance Assessment", desc: "We analyze potential infringement risks for your target market (exclusive service)." },
  { num: "03", title: "Specification Confirmation", desc: "Confirm product structure, thickness, and surface finish." },
  { num: "04", title: "Sampling & Quotation", desc: "Accurate costing for sampling and bulk production based on precise specs." },
  { num: "05", title: "Sample Approval & Compliance Review", desc: "Confirm sample performance and prepare export compliance documents." },
  { num: "06", title: "Deposit & Production Scheduling", desc: "Production slots are scheduled upon receiving the deposit." },
  { num: "07", title: "Production & Real-Time Sync", desc: "In-line quality checks during production; progress synced via SaaS portal." },
  { num: "08", title: "Final QC, Balance & Global Shipping", desc: "Final pre-shipment verification, balance payment, and FOB shipping." }
];

// ===== 模块4：定制选项与七大产品线 =====
const customizationOptions = [
  { item: "Product Type", options: "PVC Decorative Film, Peel and Stick Vinyl Flooring, PVC Wall Panel, Self-Adhesive Decorative Film, Self-adhesive Foam Wallpaper Roll, 3D PVC Wall Panel, Peel & Stick Wallpapers" },
  { item: "Patterns & Designs", options: "1000+ In-house patterns / Customer-supplied designs / Professional designer collaboration" },
  { item: "Surface Finish", options: "Matte, Flat, Embossed, 3D EIR (Synchronous Embossing)" },
  { item: "Product Structure", options: "Custom thickness, wear layer selection, adhesive type (Self-adhesive / Non-adhesive / Composite)" },
  { item: "Packaging & Labeling", options: "Custom carton layout (header boxes / color boxes / white boxes), shipping marks, and barcode printing" }
];

const productLines = [
  "PVC Decorative Film",
  "Peel and Stick Vinyl Flooring",
  "PVC Wall Panel",
  "Self-Adhesive Decorative Film",
  "Self-adhesive Foam Wallpaper Roll",
  "3D PVC Wall Panel",
  "Peel & Stick Wallpapers"
];

const productLineImages = [
  pvcFilmImg,
  lvtFlooringImg,
  pvcPanelImg,
  selfAdhesiveFilmImg,
  foamWallpaperImg,
  pvc3dImg,
  wallpapersImg,
];

// ===== 模块6：为什么选择我们（6张卡片，精简描述） =====
const serviceReasons = [
  {
    title: "Factory-Direct Pricing",
    description: "No middlemen. Pay only for true material costs and fair margins.",
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`,
    color: "from-[var(--color-primary-500)] to-[var(--color-primary-600)]"
  },
  {
    title: "In-House Cylinder Library",
    description: "1000+ in-house cylinders. Low mold setup costs, credited against bulk orders.",
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" /></svg>`,
    color: "from-[var(--color-secondary-500)] to-[var(--color-secondary-600)]"
  },
  {
    title: "Comprehensive Product Range",
    description: "7 core product lines. Matching patterns across films, floors, and wall panels, all from one source.",
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" /></svg>`,
    color: "from-[var(--color-primary-500)] to-[var(--color-primary-600)]"
  },
  {
    title: "Proactive Compliance Screening",
    description: "Pre-production infringement risk assessment for target markets to avoid takedowns and costly disputes.",
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>`,
    color: "from-[var(--color-secondary-500)] to-[var(--color-secondary-600)]"
  },
  {
    title: "Transparent Order Tracking",
    description: "Real-time production progress synced via SaaS/API. No more endless email chasing.",
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" /></svg>`,
    color: "from-[var(--color-primary-500)] to-[var(--color-primary-600)]"
  },
  {
    title: "Low MOQ & Easy Start",
    description: "Small trial orders supported. Quick sampling to confirm quality before bulk scaling.",
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M3 14h18m-9-4v8m-7 0h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" /></svg>`,
    color: "from-[var(--color-secondary-500)] to-[var(--color-secondary-600)]"
  }
];

// ===== 模块7：服务信念（5条，精简描述） =====
const serviceValues = [
  "More than materials—a secure supply chain.",
  "Zero compliance-risk issues leave our factory.",
  "Total transparency, including real-time production status.",
  "We value repeat orders over one-off deals.",
  "Fair prices with services that exceed expectations."
];

const serviceHowToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'How DecoSupplier OEM/ODM Custom Manufacturing Works',
  description: 'An 8-step service workflow for custom decorative surface material production, from request review to quality control and global shipping.',
  step: steps.map((step, index) => ({
    '@type': 'HowToStep',
    position: index + 1,
    name: step.title,
    text: step.desc,
  })),
};
---

<BaseLayout
  title="OEM/ODM Custom Manufacturing - PVC Film, LVT Flooring, PVC Wall Panel Factory"
  description="OEM/ODM production service for decorative films, flooring, and wall panels, covering sampling, customization, QC, and export shipping."
  additionalSchemas={[serviceHowToSchema]}
>
  
  <!-- ===== 模块1：HERO SECTION（已调整为 Blog 横幅排布样式，蒙版 +10% 至 /20） ===== -->
  <section class="relative py-16 md:py-24 overflow-hidden bg-slate-200">
    <div class="absolute inset-0">
      <Image 
        src={heroBgImg}
        alt="DecoSupplier Manufacturing and Custom Service"
        class="w-full h-full object-cover"
        width={1920}
        height={600}
        loading="eager"
        fetchpriority="high"
        onerror="this.style.display='none'"
      />
      <!-- 蒙版  -->
      <div class="absolute inset-0 bg-linear-to-r from-slate-700/50 via-slate-700/50 to-slate-700/10"></div>
    </div>
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-4xl">
        <div class="inline-flex items-center px-4 py-2 mb-6 bg-linear-to-r from-[var(--color-primary-600)] to-[var(--color-secondary-600)] text-white text-sm font-semibold rounded-full shadow-lg">
          <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z" clip-rule="evenodd" />
          </svg>
          From Printing to Finished Product
        </div>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-4 leading-tight">
          <span class="text-transparent bg-clip-text bg-linear-to-r from-[var(--color-primary-400)] via-[var(--color-secondary-400)] to-[var(--color-primary-400)]">OEM/ODM</span> Made Simple
        </h1>
        <p class="text-lg md:text-xl text-slate-200 max-w-2xl leading-relaxed">
          From your design concept to container-loading: 8 transparent steps, one dedicated project manager, real-time progress tracking.
        </p>
        <div class="mt-6 flex flex-col sm:flex-row gap-4">
          <a href="/contact" class="inline-flex items-center px-6 py-3 text-base font-semibold text-white bg-linear-to-r from-[var(--color-primary-600)] to-[var(--color-secondary-600)] hover:from-[var(--color-primary-700)] hover:to-[var(--color-secondary-700)] rounded-lg shadow-lg hover:shadow-xl transition-all group">
            Start Your Inquiry
            <svg class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== 模块2：三大服务支柱 ===== -->
  <Section background="white">
    <div class="text-center mb-16">
      <div class="inline-block px-4 py-2 mb-4 bg-[color:var(--color-primary-100)] text-[color:var(--color-primary-800)] text-sm font-semibold rounded-full">
        Our Service Core
      </div>
      <h2 class="text-4xl md:text-5xl font-bold text-slate-900 mb-4">
        What Our <span class="text-transparent bg-clip-text bg-linear-to-r from-[var(--color-primary-600)] to-[var(--color-secondary-600)]">OEM/ODM Service Includes</span>
      </h2>
      <p class="text-xl text-slate-600 max-w-3xl mx-auto leading-relaxed">
        Our service focus is on practical production support, product customization, and dependable execution.
      </p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-6xl mx-auto">
      {servicePillars.map((pillar, index) => (
        <Card hover class="text-center group" key={index}>
          <div class={`w-16 h-16 mx-auto mb-4 rounded-xl bg-linear-to-br ${pillar.color} flex items-center justify-center group-hover:scale-110 transition-transform shadow-lg text-white`} set:html={pillar.icon}></div>
          <h3 class="text-xl font-bold text-slate-900 mb-2">{pillar.title}</h3>
          <p class="text-slate-600 text-sm leading-relaxed px-2">{pillar.description}</p>
        </Card>
      ))}
    </div>
  </Section>

  <!-- ===== 模块3：OEM/ODM 定制服务流程 ===== -->
  <Section background="gray">
    <div class="text-center mb-16">
      <div class="inline-block px-4 py-2 mb-4 bg-[color:var(--color-secondary-100)] text-[color:var(--color-secondary-800)] text-sm font-semibold rounded-full">
        Custom Service Flow
      </div>
      <h2 class="text-4xl md:text-5xl font-bold text-slate-900 mb-4">
        Dedicated Custom Channel — <span class="text-transparent bg-clip-text bg-linear-to-r from-[var(--color-primary-600)] to-[var(--color-secondary-600)]">8 Clear Steps</span>
      </h2>
      <p class="text-xl text-slate-600 max-w-3xl mx-auto leading-relaxed">
        A transparent step-by-step roadmap, from your first inquiry to global delivery.
      </p>
    </div>
    <div class="max-w-6xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {steps.map((step, index) => (
          <div class="relative group" key={index}>
            <div class="bg-white rounded-xl p-6 shadow-md hover:shadow-xl transition-all border border-slate-100 h-full flex flex-col items-center text-center group-hover:-translate-y-1">
              <div class="w-14 h-14 rounded-full bg-linear-to-br from-[var(--color-primary-500)] to-[var(--color-secondary-500)] text-white text-xl font-bold flex items-center justify-center mb-4 shadow-md group-hover:scale-110 transition-transform">
                {step.num}
              </div>
              <h4 class="text-base font-bold text-slate-900 mb-2">{step.title}</h4>
              <p class="text-sm text-slate-500 leading-relaxed">{step.desc}</p>
            </div>
            {index < steps.length - 1 && (
              <div class="hidden lg:block absolute top-1/2 -right-3 transform -translate-y-1/2 text-blue-300">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  </Section>

  <!-- ===== 模块4：定制选项与七大产品线 ===== -->
  <Section background="white">
    <div class="text-center mb-16">
      <div class="inline-block px-4 py-2 mb-4 bg-[color:var(--color-primary-100)] text-[color:var(--color-primary-800)] text-sm font-semibold rounded-full">
        Options & Products
      </div>
      <h2 class="text-4xl md:text-5xl font-bold text-slate-900 mb-4">
        Customization Options & <span class="text-transparent bg-clip-text bg-linear-to-r from-[var(--color-primary-600)] to-[var(--color-secondary-600)]">7 Product Lines</span>
      </h2>
      <p class="text-xl text-slate-600 max-w-3xl mx-auto leading-relaxed">
        Select your service based on our customization options and product portfolio.
      </p>
    </div>
    <div class="max-w-5xl mx-auto space-y-12">
      
      <!-- 配置表 -->
      <div class="bg-slate-50 rounded-2xl overflow-hidden shadow-lg border border-slate-200">
        <div class="grid grid-cols-1 md:grid-cols-2 divide-y md:divide-y-0 md:divide-x divide-slate-200">
          {customizationOptions.map((opt, index) => (
            <div class="p-6 flex flex-col md:flex-row items-start md:items-center gap-4" key={index}>
              <div class="w-full md:w-1/3 font-bold text-slate-800 text-lg">{opt.item}</div>
              <div class="w-full md:w-2/3 text-slate-600">{opt.options}</div>
            </div>
          ))}
        </div>
      </div>

      <!-- 7大产品线 -->
      <div>
        <h3 class="text-2xl font-bold text-center text-slate-800 mb-8">7 Core Product Categories</h3>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          {productLines.map((line, index) => (
            <div class="relative bg-white rounded-lg border border-slate-200 p-4 text-center shadow-sm hover:shadow-md transition-all group" key={index}>
              <!-- Replace this placeholder with your actual product images -->
              <div class="w-full aspect-[4/3] bg-gradient-to-br from-slate-100 to-slate-200 rounded-md mb-3 overflow-hidden">
                <Image 
                  src={productLineImages[index]}
                  alt={line}
                  class="w-full h-full object-cover opacity-80 group-hover:opacity-100 transition-opacity"
                  width={400}
                  height={300}
                  loading="lazy"
                />
              </div>
              <p class="text-sm font-medium text-slate-700 group-hover:text-blue-600 transition-colors">{line}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </Section>

  <!-- ===== 模块5：品控体系与增值配套服务 ===== -->
  <Section background="gray">
    <div class="text-center mb-12">
      <div class="inline-block px-4 py-2 mb-4 bg-teal-100 text-teal-800 text-sm font-semibold rounded-full">
        Quality & Value-Added
      </div>
      <h2 class="text-4xl md:text-5xl font-bold text-slate-900 mb-4">
        Quality is the Baseline; <span class="text-transparent bg-clip-text bg-linear-to-r from-blue-600 to-teal-600">Value-Added Services Are the Plus</span>
      </h2>
    </div>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 max-w-6xl mx-auto">
      <!-- 左侧：物理品控 -->
      <div class="bg-white p-8 rounded-2xl shadow-lg border border-slate-100">
        <h3 class="text-xl font-bold text-slate-900 mb-6">I. 4-Stage Quality Control</h3>
        <ul class="space-y-4">
          {[
            { title: "Incoming Material Inspection", desc: "Base films, inks, and adhesives" },
            { title: "In-Line Monitoring", desc: "Real-time production line checks" },
            { title: "Finished Product Testing", desc: "Wear resistance, waterproofing, and colorfastness tests" },
            { title: "Pre-Shipment Verification", desc: "The final checkpoint before dispatch" }
          ].map((item, index) => (
            <li class="flex gap-4 items-start p-4 bg-slate-50 rounded-lg" key={index}>
              <span class="w-8 h-8 shrink-0 bg-blue-100 text-blue-600 rounded-full flex items-center justify-center font-bold text-sm">{index + 1}</span>
              <div>
                <div class="font-semibold text-slate-800">{item.title}</div>
                <div class="text-sm text-slate-500">{item.desc}</div>
              </div>
            </li>
          ))}
        </ul>
      </div>
      <!-- 右侧：增值服务支持 -->
      <div class="bg-white p-8 rounded-2xl shadow-lg border border-slate-100">
        <h3 class="text-xl font-bold text-slate-900 mb-6">II. Exclusive Value-Added Support</h3>
        <div class="space-y-6">
          <div class="p-5 border-l-4 border-teal-500 bg-teal-50/50 rounded-r-lg">
            <h4 class="font-bold text-slate-800 mb-2">OEM Compliance Advisory</h4>
            <p class="text-sm text-slate-600 leading-relaxed">We provide an <span class="text-teal-600 font-medium">initial pattern/design infringement risk assessment</span> for your target market, preventing compliance issues from the start.</p>
          </div>
          <div class="p-5 border-l-4 border-blue-500 bg-blue-50/50 rounded-r-lg">
            <h4 class="font-bold text-slate-800 mb-2">Digital Progress Sync</h4>
            <p class="text-sm text-slate-600 leading-relaxed">Standardized ERP APIs or a dedicated SaaS portal provide <span class="text-blue-600 font-medium">real-time production & QC status updates</span>, eliminating email follow-ups.</p>
          </div>
        </div>
      </div>
    </div>
  </Section>

  <!-- ===== 模块6：为什么选择我们的服务（6张卡片） ===== -->
  <Section background="white">
    <div class="text-center mb-16">
      <div class="inline-block px-4 py-2 mb-4 bg-blue-100 text-blue-800 text-sm font-semibold rounded-full">
        Why Choose Us
      </div>
      <h2 class="text-4xl md:text-5xl font-bold text-slate-900 mb-4">
        Why Choose <span class="text-transparent bg-clip-text bg-linear-to-r from-blue-600 to-teal-600">Our Services</span>
      </h2>
      <p class="text-xl text-slate-600 max-w-3xl mx-auto leading-relaxed">
        The essential guide to partnering with us.
      </p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {serviceReasons.map((reason, index) => (
        <Card hover class="text-center group" key={index}>
          <div class={`w-16 h-16 mx-auto mb-4 rounded-xl bg-linear-to-br ${reason.color} flex items-center justify-center group-hover:scale-110 transition-transform shadow-lg text-white`} set:html={reason.icon}></div>
          <h3 class="text-xl font-bold text-slate-900 mb-1">{reason.title}</h3>
          <p class="text-slate-600 text-sm leading-relaxed">{reason.description}</p>
        </Card>
      ))}
    </div>
  </Section>

  <!-- ===== 模块7：我们的服务信念（5条） ===== -->
  <Section background="gray">
    <div class="text-center mb-12">
      <div class="inline-block px-4 py-2 mb-4 bg-teal-100 text-teal-800 text-sm font-semibold rounded-full">
        Our Beliefs
      </div>
      <h2 class="text-4xl md:text-5xl font-bold text-slate-900 mb-4">
        Our Service <span class="text-transparent bg-clip-text bg-linear-to-r from-blue-600 to-teal-600">Philosophies</span>
      </h2>
      <p class="text-xl text-slate-600 max-w-3xl mx-auto leading-relaxed">
        Delivering B2B professionalism and reliability.
      </p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-5xl mx-auto">
      {serviceValues.map((value, index) => (
        <div class="bg-white rounded-xl p-6 shadow-md hover:shadow-xl transition-all border border-slate-100 group" key={index}>
          <div class="flex items-start space-x-4">
            <div class="w-10 h-10 shrink-0 rounded-lg bg-teal-100 text-teal-600 flex items-center justify-center group-hover:scale-110 transition-transform">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            </div>
            <p class="text-slate-800 font-medium text-base leading-relaxed">{value}</p>
          </div>
        </div>
      ))}
    </div>
  </Section>

  <!-- ===== 模块8：我们的服务团队 ===== -->
  <Section background="white">
    <div class="text-center mb-12">
      <div class="inline-block px-4 py-2 mb-4 bg-blue-100 text-blue-800 text-sm font-semibold rounded-full">
        Service Team
      </div>
      <h2 class="text-4xl md:text-5xl font-bold text-slate-900 mb-4">
        Hands-On Experts in <span class="text-transparent bg-clip-text bg-linear-to-r from-blue-600 to-teal-600">Technology, Manufacturing, and Global Markets</span>
      </h2>
    </div>
    <div class="max-w-4xl mx-auto bg-gradient-to-br from-blue-50 via-white to-teal-50 rounded-3xl p-8 md:p-12 shadow-lg border border-slate-100 text-center">
      <p class="text-lg text-slate-700 leading-relaxed">
        A pragmatic team rooted in the PVC industry, experienced in printing, adhesive, and export. Dedicated project managers handle everything from sampling to risk assessment and system integration. Your reliable overseas supply chain partner.
      </p>
    </div>
  </Section>

  <!-- ===== 模块9：联系方式与询盘入口 ===== -->
  <section class="relative py-32 overflow-hidden">
    <div class="absolute inset-0">
      <Image 
        src={ctaBgImg}
        alt="Start your custom project with DecoSupplier"
        class="w-full h-full object-cover"
        width={2070}
        height={1380}
      />
      <div class="absolute inset-0 bg-linear-to-r from-blue-900/95 to-teal-900/95"></div>
    </div>
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-4xl mx-auto text-center text-white">
        <div class="inline-block px-4 py-2 mb-6 bg-white/10 backdrop-blur-sm text-white text-sm font-semibold rounded-full">
          Let's Talk
        </div>
        <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6 leading-tight">
          Ready to Start Your <span class="text-transparent bg-clip-text bg-linear-to-r from-blue-400 to-teal-400">Custom Project</span>?
        </h2>
        <p class="text-xl md:text-2xl text-slate-200 mb-12 max-w-2xl mx-auto leading-relaxed">
          Need samples, bulk orders, or a SaaS test? Speak directly to our factory team.
        </p>
        <div class="flex flex-col sm:flex-row gap-6 justify-center">
          <a href="/contact" class="inline-flex items-center px-8 py-4 text-base font-semibold text-white bg-linear-to-r from-[var(--color-primary-600)] to-[var(--color-secondary-600)] hover:from-[var(--color-primary-700)] hover:to-[var(--color-secondary-700)] rounded-lg shadow-lg hover:shadow-xl transition-all group">
            Contact Us Now
            <svg class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
