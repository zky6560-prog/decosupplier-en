---
import BaseLayout from '@layouts/BaseLayout.astro';
import { Icon } from 'astro-iconset/components';
---

<BaseLayout
  title="Page Not Found | DecoSupplier"
  description="The page you requested could not be found. Continue browsing DecoSupplier products, services, and contact options."
  robots="noindex, follow"
>
  <section class="bg-white py-20 md:py-28">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <p class="text-sm font-semibold uppercase text-[var(--color-primary-600)]">404 Error</p>
        <h1 class="mt-4 text-4xl font-bold text-slate-900 md:text-5xl">Page Not Found</h1>
        <p class="mt-5 text-lg leading-relaxed text-slate-600">
          The requested page may have moved or no longer exists. Use the links below to continue browsing DecoSupplier.
        </p>

        <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
          <a
            href="/"
            class="inline-flex w-full items-center justify-center rounded-lg bg-[var(--color-primary-600)] px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-[var(--color-primary-700)] sm:w-auto"
          >
            <Icon name="lucide:home" class="mr-2 h-4 w-4" />
            Back to Home
          </a>
          <a
            href="/products"
            class="inline-flex w-full items-center justify-center rounded-lg border border-slate-300 px-6 py-3 text-sm font-semibold text-slate-800 transition-colors hover:border-[var(--color-primary-500)] hover:text-[var(--color-primary-700)] sm:w-auto"
          >
            <Icon name="lucide:package-search" class="mr-2 h-4 w-4" />
            View Products
          </a>
          <a
            href="/contact"
            class="inline-flex w-full items-center justify-center rounded-lg border border-slate-300 px-6 py-3 text-sm font-semibold text-slate-800 transition-colors hover:border-[var(--color-primary-500)] hover:text-[var(--color-primary-700)] sm:w-auto"
          >
            <Icon name="lucide:mail" class="mr-2 h-4 w-4" />
            Contact Us
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
