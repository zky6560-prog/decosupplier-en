---
import BaseLayout from '@layouts/BaseLayout.astro';
import Section from '@components/ui/Section.astro';
import Card from '@components/ui/Card.astro';
import RFQForm from '@components/react/RFQForm';
import { Image } from 'astro:assets';
import { Icon } from 'astro-iconset/components';
import rfqBgImg from '@assets/factory-direct-pvc-decorative-film.png';
import warehouseImg from '@assets/photo-1563013544-824ae1b704d3.jpg';
---

<BaseLayout
  title="Contact DecoSupplier - Get Free Samples, Factory Quotes & OEM/ODM Support"
  description="Tell us about your project. Free samples in 3-7 days. Factory-direct quote in 24 hours. No commitment."
  schemaType="ContactPage"
>
  <!-- ===== Hero Section（手机端左对齐 + 高度 2/3） ===== -->
  <section class="relative h-[333px] md:h-[600px] flex items-center overflow-hidden">
    <div class="absolute inset-0">
      <Image 
        src={rfqBgImg}
        alt="DecoSupplier manufacturing and surface decoration solutions"
        class="w-full h-full object-cover"
        width={2070}
        height={1380}
      />
      <div class="absolute inset-0 bg-linear-to-r from-slate-700/50 via-slate-700/50 to-slate-700/10"></div>
    </div>

    <div class="container mx-auto relative z-10 px-4 sm:px-6 lg:px-8">
      <!-- 手机端左对齐，电脑端保持居中 -->
      <div class="max-w-4xl mx-auto text-left md:text-center">
        <h1 class="text-4xl md:text-6xl lg:text-7xl font-bold text-white mb-6 leading-tight animate-fadeInUp">
          Contact <span class="text-transparent bg-clip-text bg-linear-to-r from-[var(--color-primary-400)] via-[var(--color-secondary-400)] to-[var(--color-primary-400)]">DecoSupplier</span>
        </h1>
        <p class="text-xl md:text-2xl text-white max-w-3xl mx-auto leading-relaxed animate-fadeInUp md:mx-auto" style="animation-delay: 0.2s">
          Tell us about your project. Free samples in 3-7 days. Factory-direct quote in 24 hours. No commitment.
        </p>
        <!-- 其他元素已移除 -->
      </div>
    </div>
  </section>

  <!-- ===== Main Form Section ===== -->
  <Section background="gray">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
      <!-- Form -->
      <div class="lg:col-span-2">
        <Card>
          <RFQForm client:load />
        </Card>
      </div>

      <!-- Sidebar -->
      <div class="space-y-6">
        <!-- Contact Info Card -->
        <Card class="bg-linear-to-br from-[var(--color-primary-50)] to-[var(--color-secondary-50)] border-[var(--color-primary-200)]">
          <div class="flex items-center mb-4">
            <div class="w-10 h-10 rounded-lg bg-linear-to-br from-[var(--color-primary-600)] to-[var(--color-secondary-600)] flex items-center justify-center mr-3">
              <Icon name="lucide:phone" class="w-5 h-5 text-white" />
            </div>
            <h3 class="text-xl font-bold text-gray-900">Need Help?</h3>
          </div>
          <div class="space-y-4 text-sm">
            <div class="flex items-start space-x-3 p-3 bg-white rounded-lg hover:shadow-md transition-shadow">
              <div class="w-10 h-10 rounded-lg bg-[color:var(--color-primary-100)] flex items-center justify-center shrink-0">
                <Icon name="lucide:phone" class="w-5 h-5 text-[var(--color-primary-600)]" />
              </div>
              <div>
                <div class="font-semibold text-gray-900">Phone</div>
                <div class="text-gray-600 font-medium">+86 153 0581 9072</div>
                <div class="text-gray-500 text-xs">Mon-Fri, 8:00 AM - 6:00 PM (UTC+8)</div>
              </div>
            </div>

            <div class="flex items-start space-x-3 p-3 bg-white rounded-lg hover:shadow-md transition-shadow">
              <div class="w-10 h-10 rounded-lg bg-[color:var(--color-secondary-100)] flex items-center justify-center shrink-0">
                <Icon name="lucide:mail" class="w-5 h-5 text-[var(--color-secondary-600)]" />
              </div>
              <div>
                <div class="font-semibold text-gray-900">Email</div>
                <div class="text-gray-600 font-medium">info@decosupplier.com</div>
                <div class="text-gray-500 text-xs">We reply within 24 hours — guaranteed</div>
              </div>
            </div>

            <div class="flex items-start space-x-3 p-3 bg-white rounded-lg hover:shadow-md transition-shadow">
              <div class="w-10 h-10 rounded-lg bg-green-100 flex items-center justify-center shrink-0">
                <Icon name="lucide:map-pin" class="w-5 h-5 text-green-600" />
              </div>
              <div>
                <div class="font-semibold text-gray-900">Sales &amp; Trade Office</div>
                <div class="text-gray-600 font-medium">Hangzhou, Zhejiang</div>
                <div class="text-gray-500 text-xs">5th Floor, Huarui Huijin Center, Beigan Sub-district, Xiaoshan District, Hangzhou City, Zhejiang Province, P.R.China</div>
              </div>
            </div>

            <div class="flex items-start space-x-3 p-3 bg-white rounded-lg hover:shadow-md transition-shadow">
              <div class="w-10 h-10 rounded-lg bg-green-100 flex items-center justify-center shrink-0">
                <Icon name="lucide:factory" class="w-5 h-5 text-green-600" />
              </div>
              <div>
                <div class="font-semibold text-gray-900">Factory Location</div>
                <div class="text-gray-600 font-medium">Huangshan, Anhui</div>
                <div class="text-gray-500 text-xs">She County Economic Development Zone, Huangshan City, Anhui Province, P.R.China</div>
              </div>
            </div>
          </div>
        </Card>

        <!-- What to Expect Card -->
        <Card class="bg-linear-to-br from-[var(--color-primary-50)] via-[var(--color-primary-100)] to-[var(--color-secondary-50)] border-[var(--color-primary-200)]">
          <div class="flex items-center mb-4">
            <div class="w-10 h-10 rounded-lg bg-linear-to-br from-[var(--color-primary-600)] to-[var(--color-primary-700)] flex items-center justify-center mr-3">
              <Icon name="lucide:clock" class="w-5 h-5 text-white" />
            </div>
            <h3 class="text-xl font-bold text-gray-900">4 Steps from Inquiry to Delivery</h3>
          </div>
          <ol class="space-y-4 text-sm">
            <li class="flex items-start space-x-3 p-3 bg-white rounded-lg hover:shadow-md transition-shadow">
              <span class="shrink-0 w-8 h-8 rounded-full bg-linear-to-br from-[var(--color-primary-600)] to-[var(--color-primary-700)] text-white flex items-center justify-center font-bold text-sm shadow-md">1</span>
              <div>
                <span class="text-gray-900 font-semibold block">Consultation</span>
                <span class="text-gray-600">You tell us your requirements — product type, pattern, quantity, target market</span>
              </div>
            </li>
            <li class="flex items-start space-x-3 p-3 bg-white rounded-lg hover:shadow-md transition-shadow">
              <span class="shrink-0 w-8 h-8 rounded-full bg-linear-to-br from-[var(--color-secondary-600)] to-[var(--color-secondary-700)] text-white flex items-center justify-center font-bold text-sm shadow-md">2</span>
              <div>
                <span class="text-gray-900 font-semibold block">Sampling</span>
                <span class="text-gray-600">Free samples sent for your approval</span>
              </div>
            </li>
            <li class="flex items-start space-x-3 p-3 bg-white rounded-lg hover:shadow-md transition-shadow">
              <span class="shrink-0 w-8 h-8 rounded-full bg-linear-to-br from-[var(--color-secondary-500)] to-[var(--color-secondary-600)] text-white flex items-center justify-center font-bold text-sm shadow-md">3</span>
              <div>
                <span class="text-gray-900 font-semibold block">Production</span>
                <span class="text-gray-600">Full-scale manufacturing with quality control</span>
              </div>
            </li>
            <li class="flex items-start space-x-3 p-3 bg-white rounded-lg hover:shadow-md transition-shadow">
              <span class="shrink-0 w-8 h-8 rounded-full bg-linear-to-br from-[var(--color-primary-600)] to-[var(--color-primary-700)] text-white flex items-center justify-center font-bold text-sm shadow-md">4</span>
              <div>
                <span class="text-gray-900 font-semibold block">Delivery</span>
                <span class="text-gray-600">Reliable shipping to your destination</span>
              </div>
            </li>
          </ol>
        </Card>

        <!-- Trust Indicators -->
        <Card class="bg-linear-to-br from-slate-50 to-gray-50 border-slate-200">
          <div class="flex items-center mb-4">
            <div class="w-10 h-10 rounded-lg bg-linear-to-br from-green-600 to-emerald-600 flex items-center justify-center mr-3">
              <Icon name="lucide:award" class="w-5 h-5 text-white" />
            </div>
            <h3 class="text-xl font-bold text-gray-900">Why Choose Us?</h3>
          </div>
          <ul class="space-y-3 text-sm">
            <li class="flex items-start space-x-3 p-3 bg-white rounded-lg hover:shadow-md transition-shadow">
              <div class="w-8 h-8 rounded-lg bg-blue-100 flex items-center justify-center shrink-0">
                <Icon name="lucide:factory" class="w-4 h-4 text-blue-600" />
              </div>
              <span class="text-gray-700 pt-1">15+ years of manufacturing expertise</span>
            </li>
            <li class="flex items-start space-x-3 p-3 bg-white rounded-lg hover:shadow-md transition-shadow">
              <div class="w-8 h-8 rounded-lg bg-teal-100 flex items-center justify-center shrink-0">
                <Icon name="lucide:circle-check" class="w-4 h-4 text-teal-600" />
              </div>
              <span class="text-gray-700 pt-1">1000+ in-stock print cylinders</span>
            </li>
            <li class="flex items-start space-x-3 p-3 bg-white rounded-lg hover:shadow-md transition-shadow">
              <div class="w-10 h-10 rounded-lg bg-[color:var(--color-primary-100)] flex items-center justify-center shrink-0">
                <Icon name="lucide:shield" class="w-4 h-4 text-[var(--color-primary-600)]" />
              </div>
              <span class="text-gray-700 pt-1">ISO certified production</span>
            </li>
            <li class="flex items-start space-x-3 p-3 bg-white rounded-lg hover:shadow-md transition-shadow">
              <div class="w-8 h-8 rounded-lg bg-orange-100 flex items-center justify-center shrink-0">
                <Icon name="lucide:globe" class="w-4 h-4 text-orange-600" />
              </div>
              <span class="text-gray-700 pt-1">Exporting to 30+ countries</span>
            </li>
          </ul>
        </Card>
      </div>
    </div>
  </Section>

  <!-- ===== Trust & Success Section ===== -->
  <Section background="white">
    <div class="text-center mb-12">
      <div class="inline-block px-4 py-2 mb-4 bg-[var(--color-primary-100)] text-[var(--color-primary-800)] text-sm font-semibold rounded-full">
        Trusted by Industry Leaders
      </div>
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
        Why Global Buyers Choose <span class="text-transparent bg-clip-text bg-linear-to-r from-[var(--color-primary-600)] to-[var(--color-secondary-600)]">DecoSupplier</span>
      </h2>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto">
        From single-family homes to commercial projects, our surface materials are trusted by brands and contractors worldwide.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12">
      <Card class="text-center hover:shadow-xl transition-all duration-300">
        <div class="w-16 h-16 rounded-full bg-linear-to-br from-[var(--color-primary-600)] to-[var(--color-secondary-600)] flex items-center justify-center mx-auto mb-4">
          <Icon name="lucide:shield" class="w-8 h-8 text-white" />
        </div>
        <h3 class="text-xl font-bold text-gray-900 mb-2">Factory-Direct Quality</h3>
        <p class="text-gray-600">
          No middlemen — you pay for the material itself, not layers of markup.
        </p>
      </Card>

      <Card class="text-center hover:shadow-xl transition-all duration-300">
        <div class="w-16 h-16 rounded-full bg-linear-to-br from-[var(--color-secondary-500)] to-[var(--color-secondary-600)] flex items-center justify-center mx-auto mb-4">
          <Icon name="lucide:trending-up" class="w-8 h-8 text-white" />
        </div>
        <h3 class="text-xl font-bold text-gray-900 mb-2">Unmatched Selection</h3>
        <p class="text-gray-600">
          1000+ patterns in stock — wood, marble, microcement, and more.
        </p>
      </Card>

      <Card class="text-center hover:shadow-xl transition-all duration-300">
        <div class="w-16 h-16 rounded-full bg-linear-to-br from-[var(--color-primary-600)] to-[var(--color-primary-700)] flex items-center justify-center mx-auto mb-4">
          <Icon name="lucide:users" class="w-8 h-8 text-white" />
        </div>
        <h3 class="text-xl font-bold text-gray-900 mb-2">Expert Support</h3>
        <p class="text-gray-600">
          Direct factory team support — no language barriers, no middlemen.
        </p>
      </Card>
    </div>

    <div class="relative rounded-2xl overflow-hidden shadow-2xl">
      <div class="absolute inset-0">
        <Image 
          src={warehouseImg}
          alt="DecoSupplier manufacturing facility and operations"
          class="w-full h-full object-cover"
          width={2070}
          height={800}
        />
      <div class="absolute inset-0 bg-linear-to-r from-slate-700/50 via-slate-700/90 to-slate-700/10"></div>
      </div>
      <div class="relative z-10 p-12 md:p-16 text-center text-white">
        <h3 class="text-3xl md:text-4xl font-bold mb-4">
          Ready to Start Your Project?
        </h3>
        <p class="text-xl text-slate-200 mb-8 max-w-2xl mx-auto">
          Contact us today for free sample swatches and factory-direct quotes.
        </p>
        <a 
          href="#rfq-form" 
          class="inline-flex items-center px-8 py-4 bg-linear-to-r from-[var(--color-primary-600)] to-[var(--color-secondary-600)] hover:from-[var(--color-primary-700)] hover:to-[var(--color-secondary-700)] text-white font-semibold rounded-lg shadow-lg hover:shadow-xl transition-all duration-200"
        >
          Send Inquiry & Get Free Samples
          <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </a>
      </div>
    </div>
  </Section>
</BaseLayout>
