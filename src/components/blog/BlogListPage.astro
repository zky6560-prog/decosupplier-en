---
import Section from '@components/ui/Section.astro';
import { Image } from 'astro:assets';
import { Icon } from 'astro-iconset/components';
import type { BlogPostWithContent } from '@/utils/nocobasePages';

import ctaBgImg from '@assets/photo-1553413077-190dd305871c.jpg';
import blogHeroImg from '@assets/blogbaner.jpg';

interface Props {
  posts: BlogPostWithContent[];
  allPosts: BlogPostWithContent[];
  currentPage: number;
  totalPages: number;
  postsPerPage: number;
}

const { posts, allPosts, currentPage, totalPages, postsPerPage } = Astro.props;

const categoryNames = ['All', ...new Set(allPosts.map((post) => post.category).filter(Boolean))];
const categories = categoryNames.map((name) => {
  const slug = name.toLowerCase().replace(/\s+/g, '-');
  const count = name === 'All'
    ? allPosts.length
    : allPosts.filter((post) => post.category === name).length;

  return { name, slug, count };
});

const getPageUrl = (page: number) => page === 1 ? '/Blog/' : `/Blog/page/${page}/`;
const pageNumbers = Array.from({ length: totalPages }, (_, index) => index + 1);
---

<!-- ===== HERO SECTION ===== -->
<section class="relative py-16 md:py-24 overflow-hidden bg-slate-200">
  <div class="absolute inset-0">
    <Image
      src={blogHeroImg}
      alt="DecoSupplier blog and factory updates"
      class="w-full h-full object-cover"
      width={1920}
      height={600}
      loading="eager"
      fetchpriority="high"
      onerror="this.style.display='none'"
    />
    <div class="absolute inset-0 bg-linear-to-r from-slate-700/50 via-slate-700/50 to-slate-700/10"></div>
  </div>
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="max-w-4xl">
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-4">
        Factory Updates &amp; <span class="text-transparent bg-clip-text bg-linear-to-r from-blue-400 to-teal-400">Technical Guides</span>
      </h1>
      <p class="text-lg md:text-xl text-slate-200 max-w-2xl leading-relaxed">
        Frontline factory updates, technical guides, and industry trend analysis from DecoSupplier - providing deep content reference for global buyers.
      </p>
    </div>
  </div>
</section>

<!-- ===== BLOG LIST ===== -->
<Section background="white" class="py-12">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col lg:flex-row gap-12">
      <div class="flex-1">
        <div class="flex flex-wrap gap-2 mb-8 pb-6 border-b border-slate-200">
          {categories.map((cat) => (
            <button
              data-category={cat.slug}
              class={`category-btn px-4 py-2 text-sm font-medium rounded-full transition-all ${
                cat.slug === 'all'
                  ? 'bg-blue-600 text-white'
                  : 'text-slate-600 hover:bg-slate-100 hover:text-blue-600'
              }`}
              type="button"
            >
              {cat.name} <span class="text-xs opacity-70">({cat.count})</span>
            </button>
          ))}
        </div>

        <div id="post-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-2 gap-8">
          {posts.map((post) => (
            <article class="group bg-white rounded-sm overflow-hidden shadow-sm hover:shadow-xl transition-all hover:-translate-y-1" key={post.id} data-category={post.category.toLowerCase().replace(/\s+/g, '-')}>
              <a href={`/Blog/${post.slug}`} class="block">
                <div class="relative aspect-[16/9] overflow-hidden bg-slate-100">
                  <img
                    src={post.coverImage}
                    alt={post.title}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    loading="lazy"
                    onerror="this.style.display='none'"
                  />
                  {post.isFeatured && (
                    <div class="absolute top-4 left-4 bg-amber-500 text-white text-xs font-semibold px-3 py-1 rounded-full shadow-lg flex items-center gap-1">
                      <Icon name="lucide:star" class="w-3.5 h-3.5" />
                      Featured
                    </div>
                  )}

                  <div class="absolute inset-0 bg-slate-900/0 group-hover:bg-slate-900/60 transition-all duration-300 flex items-center justify-center pointer-events-none">
                    <span class="text-white text-sm font-semibold bg-blue-600 px-5 py-2.5 rounded-full transform translate-y-4 group-hover:translate-y-0 transition-all duration-300 opacity-0 group-hover:opacity-100 shadow-lg">
                      Read More
                    </span>
                  </div>
                </div>
              </a>

              <div class="p-5 md:p-6">
                <a href={`/Blog/${post.slug}`} class="block hover:text-blue-600 transition-colors">
                  <h2 class="text-lg font-bold text-slate-900 leading-tight line-clamp-2">
                    {post.title}
                  </h2>
                </a>

                <p class="text-sm text-slate-600 mt-2 line-clamp-3 leading-relaxed">
                  {post.excerpt}
                </p>

                <div class="flex items-center justify-between mt-4 pt-4 border-t border-slate-100">
                  <div class="flex items-center gap-3 text-xs text-slate-500">
                    <div class="flex items-center gap-2">
                      <div class="w-6 h-6 rounded-full bg-slate-200 flex items-center justify-center text-slate-500 text-[10px] font-semibold">
                        {post.author.charAt(0)}
                      </div>
                      <span class="font-medium text-slate-800">{post.author}</span>
                    </div>
                    <span class="text-slate-300">|</span>
                    <span class="text-blue-600">{post.category}</span>
                    <span>|</span>
                    <time datetime={post.publishedAt}>{post.publishedAt}</time>
                  </div>
                </div>
              </div>
            </article>
          ))}
        </div>

        <nav id="pagination-container" class="flex items-center justify-center gap-2 mt-12 pt-8 border-t border-slate-200" aria-label="Blog pagination">
          {currentPage > 1 ? (
            <a href={getPageUrl(currentPage - 1)} class="px-4 py-2 text-sm font-medium text-slate-600 border border-slate-300 hover:bg-slate-50 hover:text-blue-600 rounded-lg transition-all">Previous</a>
          ) : (
            <span class="px-4 py-2 text-sm font-medium text-slate-300 border border-slate-200 cursor-not-allowed rounded-lg">Previous</span>
          )}

          {pageNumbers.map((page) => (
            <a
              href={getPageUrl(page)}
              class={`px-4 py-2 text-sm font-medium rounded-lg transition-all ${
                page === currentPage
                  ? 'bg-blue-600 text-white'
                  : 'text-slate-600 border border-slate-300 hover:bg-slate-50 hover:text-blue-600'
              }`}
              aria-current={page === currentPage ? 'page' : undefined}
            >
              {page}
            </a>
          ))}

          {currentPage < totalPages ? (
            <a href={getPageUrl(currentPage + 1)} class="px-4 py-2 text-sm font-medium text-slate-600 border border-slate-300 hover:bg-slate-50 hover:text-blue-600 rounded-lg transition-all">Next</a>
          ) : (
            <span class="px-4 py-2 text-sm font-medium text-slate-300 border border-slate-200 cursor-not-allowed rounded-lg">Next</span>
          )}
        </nav>
      </div>

      <aside class="lg:w-80 shrink-0">
        <div class="sticky top-24 space-y-8">
          <div class="bg-slate-50 rounded-xl p-6 border border-slate-200">
            <h3 class="text-sm font-semibold text-slate-700 uppercase tracking-wider mb-4">Categories</h3>
            <ul class="space-y-2">
              {categories.map((cat) => (
                <li key={cat.slug}>
                  <button
                    data-category={cat.slug}
                    class="category-btn-sidebar flex items-center justify-between w-full text-sm transition-colors text-slate-600 hover:text-blue-600"
                    type="button"
                  >
                    <span>{cat.name}</span>
                    <span class="text-xs text-slate-400">({cat.count})</span>
                  </button>
                </li>
              ))}
            </ul>
          </div>

          <div class="bg-slate-50 rounded-xl p-6 border border-slate-200">
            <h3 class="text-sm font-semibold text-slate-700 uppercase tracking-wider mb-4">Popular Articles</h3>
            <ul class="space-y-3">
              {allPosts.slice(0, 6).map((post) => (
                <li key={post.slug}>
                  <a href={`/Blog/${post.slug}`} class="text-sm text-slate-700 hover:text-blue-600 transition-colors line-clamp-1 leading-relaxed">
                    {post.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <a href="/contact" class="block bg-linear-to-br from-blue-600 to-teal-600 rounded-xl p-6 text-white hover:shadow-xl transition-all hover:scale-[1.02]">
            <h3 class="text-lg font-bold mb-2">Stay Connected</h3>
            <p class="text-sm text-white/80 mb-4">
              Have questions about our products or need expert advice? Reach out to our team today.
            </p>
            <div class="inline-flex items-center px-6 py-2.5 bg-white text-blue-700 font-semibold rounded-lg hover:bg-slate-100 transition-colors text-sm">
              Contact Our Team
              <Icon name="lucide:arrow-right" class="w-4 h-4 ml-2" />
            </div>
          </a>
        </div>
      </aside>
    </div>
  </div>
</Section>

<section class="relative py-20 overflow-hidden">
  <div class="absolute inset-0">
    <Image
      src={ctaBgImg}
      alt="DecoSupplier factory and operations"
      class="w-full h-full object-cover"
      width={2070}
      height={1380}
    />
    <div class="absolute inset-0 bg-linear-to-r from-blue-900/95 to-teal-900/95"></div>
  </div>
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="max-w-3xl mx-auto text-center text-white">
      <h2 class="text-3xl md:text-4xl font-bold mb-4">Want to Learn More?</h2>
      <p class="text-lg text-slate-200 mb-8">
        Browse our product range or contact our sales team for expert advice.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/products" class="inline-flex items-center justify-center px-8 py-4 bg-white text-blue-900 font-semibold rounded-lg hover:bg-slate-100 transition-all shadow-lg hover:shadow-xl">
          View Products
          <Icon name="lucide:arrow-right" class="w-5 h-5 ml-2" />
        </a>
        <a href="/contact" class="inline-flex items-center justify-center px-8 py-4 border-2 border-white text-white font-semibold rounded-lg hover:bg-white/10 transition-all">
          Contact Us
          <Icon name="lucide:send" class="w-5 h-5 ml-2" />
        </a>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ posts: allPosts, perPage: postsPerPage }}>
  const allPostsData = posts;
  const postsPerPage = perPage;

  function escapeHtml(value) {
    return String(value ?? '').replace(/[&<>'"]/g, (character) => ({
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      "'": '&#39;',
      '"': '&quot;',
    })[character]);
  }

  function getFilteredPosts(category) {
    if (category === 'all') return allPostsData;
    return allPostsData.filter((post) => post.category.toLowerCase().replace(/\s+/g, '-') === category);
  }

  function getPageNumbers(total) {
    return Array.from({ length: total }, (_, index) => index + 1);
  }

  function renderPosts(category, currentPage = 1) {
    const grid = document.getElementById('post-grid');
    if (!grid) return;

    const filtered = getFilteredPosts(category);
    const totalPages = Math.max(1, Math.ceil(filtered.length / postsPerPage));
    const safePage = Math.min(Math.max(currentPage, 1), totalPages);
    const pagePosts = filtered.slice((safePage - 1) * postsPerPage, safePage * postsPerPage);

    if (pagePosts.length === 0) {
      grid.innerHTML = '<div class="col-span-1 lg:col-span-2 text-center py-16 text-slate-500"><p class="text-lg font-medium text-slate-700">No articles found</p><p class="text-sm">Try selecting a different category</p></div>';
      return;
    }

    grid.innerHTML = pagePosts.map((post) => {
      const catSlug = post.category.toLowerCase().replace(/\s+/g, '-');
      return `
        <article class="group bg-white rounded-sm overflow-hidden shadow-sm hover:shadow-xl transition-all hover:-translate-y-1" data-category="${catSlug}">
          <a href="/Blog/${post.slug}" class="block">
            <div class="relative aspect-[16/9] overflow-hidden bg-slate-100">
              <img src="${escapeHtml(post.coverImage)}" alt="${escapeHtml(post.title)}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" onerror="this.style.display='none'" />
              ${post.isFeatured ? '<div class="absolute top-4 left-4 bg-amber-500 text-white text-xs font-semibold px-3 py-1 rounded-full shadow-lg flex items-center gap-1">Featured</div>' : ''}
              <div class="absolute inset-0 bg-slate-900/0 group-hover:bg-slate-900/60 transition-all duration-300 flex items-center justify-center pointer-events-none">
                <span class="text-white text-sm font-semibold bg-blue-600 px-5 py-2.5 rounded-full transform translate-y-4 group-hover:translate-y-0 transition-all duration-300 opacity-0 group-hover:opacity-100 shadow-lg">Read More</span>
              </div>
            </div>
          </a>
          <div class="p-5 md:p-6">
            <a href="/Blog/${escapeHtml(post.slug)}" class="block hover:text-blue-600 transition-colors"><h2 class="text-lg font-bold text-slate-900 leading-tight line-clamp-2">${escapeHtml(post.title)}</h2></a>
            <p class="text-sm text-slate-600 mt-2 line-clamp-3 leading-relaxed">${escapeHtml(post.excerpt)}</p>
            <div class="flex items-center justify-between mt-4 pt-4 border-t border-slate-100">
              <div class="flex items-center gap-3 text-xs text-slate-500">
                <div class="flex items-center gap-2"><div class="w-6 h-6 rounded-full bg-slate-200 flex items-center justify-center text-slate-500 text-[10px] font-semibold">${escapeHtml(post.author.charAt(0))}</div><span class="font-medium text-slate-800">${escapeHtml(post.author)}</span></div>
                <span class="text-slate-300">|</span><span class="text-blue-600">${escapeHtml(post.category)}</span><span>|</span><time datetime="${escapeHtml(post.publishedAt)}">${escapeHtml(post.publishedAt)}</time>
              </div>
            </div>
          </div>
        </article>
      `;
    }).join('');

    renderFilteredPagination(category, safePage, totalPages);
  }

  function renderFilteredPagination(category, currentPage, totalPages) {
    const container = document.getElementById('pagination-container');
    if (!container) return;

    const previous = currentPage > 1
      ? `<button type="button" data-pagination-page="${currentPage - 1}" class="px-4 py-2 text-sm font-medium text-slate-600 border border-slate-300 hover:bg-slate-50 hover:text-blue-600 rounded-lg transition-all">Previous</button>`
      : '<span class="px-4 py-2 text-sm font-medium text-slate-300 border border-slate-200 cursor-not-allowed rounded-lg">Previous</span>';
    const pages = getPageNumbers(totalPages).map((page) => (
      `<button type="button" data-pagination-page="${page}" class="px-4 py-2 text-sm font-medium rounded-lg transition-all ${page === currentPage ? 'bg-blue-600 text-white' : 'text-slate-600 border border-slate-300 hover:bg-slate-50 hover:text-blue-600'}"${page === currentPage ? ' aria-current="page"' : ''}>${page}</button>`
    )).join('');
    const next = currentPage < totalPages
      ? `<button type="button" data-pagination-page="${currentPage + 1}" class="px-4 py-2 text-sm font-medium text-slate-600 border border-slate-300 hover:bg-slate-50 hover:text-blue-600 rounded-lg transition-all">Next</button>`
      : '<span class="px-4 py-2 text-sm font-medium text-slate-300 border border-slate-200 cursor-not-allowed rounded-lg">Next</span>';

    container.innerHTML = `${previous}${pages}${next}`;
  }

  function updateActiveButton(activeSlug) {
    document.querySelectorAll('.category-btn').forEach((button) => {
      const isActive = button.dataset.category === activeSlug;
      button.className = isActive
        ? 'category-btn px-4 py-2 text-sm font-medium rounded-full transition-all bg-blue-600 text-white'
        : 'category-btn px-4 py-2 text-sm font-medium rounded-full transition-all text-slate-600 hover:bg-slate-100 hover:text-blue-600';
    });

    document.querySelectorAll('.category-btn-sidebar').forEach((button) => {
      const isActive = button.dataset.category === activeSlug;
      button.className = isActive
        ? 'category-btn-sidebar flex items-center justify-between w-full text-sm transition-colors text-blue-600 font-medium'
        : 'category-btn-sidebar flex items-center justify-between w-full text-sm transition-colors text-slate-600 hover:text-blue-600';
    });
  }

  function filterByCategory(categorySlug) {
    renderPosts(categorySlug, 1);
    updateActiveButton(categorySlug);
  }

  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.category-btn, .category-btn-sidebar').forEach((button) => {
      button.addEventListener('click', () => filterByCategory(button.dataset.category));
    });

    document.getElementById('pagination-container')?.addEventListener('click', (event) => {
      const button = event.target.closest('[data-pagination-page]');
      if (!button) return;
      const activeCategory = document.querySelector('.category-btn.bg-blue-600')?.dataset.category || 'all';
      renderPosts(activeCategory, Number(button.dataset.paginationPage));
    });
  });
</script>
