---
import { NAVIGATION } from '@config/site';
import { Icon } from 'astro-iconset/components';
import MobileMenu from '@components/react/MobileMenu';
import { getProductCategories, type ProductCategory } from '@/utils/nocobaseCategories';

const { currentPathname } = Astro.props;
const isActiveLink = (href: string): boolean => href === currentPathname;

const allProducts: ProductCategory = {
  id: 'all',
  name: 'All Products',
  slug: 'all-products',
  href: '/products',
  image: '/assets/product/product (1).jpg',
};

const productItems = [
  allProducts,
  ...(await getProductCategories()),
];
---

<header class="sticky top-0 z-50 w-full border-b border-slate-200 bg-white/95 backdrop-blur-md shadow-sm">
  <nav class="container mx-auto flex h-20 items-center justify-between px-4 sm:px-6 lg:px-8">
    <!-- Logo -->
    <div class="flex items-center">
      <a href="/" class="flex items-center group">
        <img src="/logo.png" alt="DecoSupplier" class="h-10 w-auto group-hover:opacity-90 transition-opacity" />
      </a>
    </div>

    <!-- Desktop Navigation -->
    <div class="hidden lg:flex lg:items-center lg:space-x-1">
      {NAVIGATION.map((item) => {
        const isActive = isActiveLink(item.href);
        if (item.name === 'Products') {
          return (
            <div class="relative group" key={item.href}>
              <button
                class={`px-4 py-2 text-sm font-medium text-slate-700 hover:text-[var(--color-primary-600)] rounded-lg transition-all flex items-center gap-1 ${
                  isActive ? 'nav-active' : ''
                }`}
                style="background: white;"
              >
                {item.name}
                <Icon name="lucide:chevron-down" class="w-4 h-4" />
              </button>

              <div class="absolute left-0 right-0 top-full h-8 pointer-events-auto" style="margin-top: -4px;"></div>

              <div
                class="fixed left-0 right-0 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50 pointer-events-none group-hover:pointer-events-auto"
                style="top: 80px; margin-top: -8px;"
              >
                <div class="w-full bg-white" style="box-shadow: none; border: none; border-radius: 0;">
                  <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-6">
                    <div class="grid grid-cols-4 gap-5">
                      {productItems.map((product) => {
                        const imgSrc = product.image || allProducts.image;
                        const isAllProducts = product.name === 'All Products';
                        return (
                          <a
                            href={product.href}
                            class={`group/card flex flex-col items-center p-4 bg-white transition-all duration-200 ${
                              isAllProducts
                                ? 'bg-[color:var(--color-primary-50)]/30 hover:bg-[color:var(--color-primary-100)]/50'
                                : 'hover:bg-slate-50'
                            }`}
                          >
                            <div class="w-full aspect-[3/2] overflow-hidden bg-slate-50 relative">
                              <img
                                src={imgSrc}
                                alt={product.name}
                                class="w-full h-full object-cover transition-transform duration-300 group-hover/card:scale-105"
                                loading="lazy"
                              />
                              <div class="absolute inset-0 flex items-center justify-center bg-[color:var(--color-primary-600)]/10 backdrop-blur-[2px] opacity-0 group-hover/card:opacity-100 transition-opacity duration-300">
                                  <span class="px-3 py-1 text-xs font-semibold text-white bg-[color:var(--color-primary-600)]/80 rounded-full backdrop-blur-sm">
                                    View All
                                  </span>
                                </div>
                            </div>
                            <span class="mt-3 text-sm font-medium text-slate-700 text-center leading-tight line-clamp-2 group-hover/card:text-[var(--color-primary-600)] transition-colors">
                              {product.name}
                            </span>
                          </a>
                        );
                      })}
                    </div>
                  </div>
                </div>
              </div>
            </div>
          );
        }
        return (
          <a
            href={item.href}
            class={`px-4 py-2 text-sm font-medium text-slate-700 hover:text-[var(--color-primary-600)] hover:bg-[color:var(--color-primary-50)] rounded-lg transition-all relative group ${
              isActive ? 'nav-active' : ''
            }`}
            key={item.href}
          >
            {item.name}
          </a>
        );
      })}
    </div>

    <!-- CTA Button -->
    <div class="hidden lg:flex lg:items-center lg:space-x-4">
      <a
        href="/contact"
        class="inline-flex items-center px-6 py-2.5 text-sm font-semibold text-white bg-linear-to-r from-[var(--color-primary-600)] to-[var(--color-primary-700)] hover:from-[var(--color-primary-700)] hover:to-[var(--color-primary-800)] rounded-lg shadow-md hover:shadow-lg transition-all"
      >
        Get Free Samples
      </a>
    </div>

    <!-- Mobile Menu Button -->
    <MobileMenu productItems={productItems} client:idle />
  </nav>
</header>
