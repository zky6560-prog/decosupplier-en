---
import { Icon } from 'astro-iconset/components';

interface Props {
  items: Array<{ question: string; answer: string }>;
}

const { items } = Astro.props;
---

<div class="space-y-4">
  {items.map((item) => (
    <details class="group border border-slate-200 rounded-lg hover:border-blue-300 transition-colors">
      <summary class="flex items-center justify-between p-4 cursor-pointer list-none">
        <span class="font-medium text-slate-800 group-hover:text-blue-600 transition-colors">{item.question}</span>
        <Icon name="lucide:chevron-down" class="w-5 h-5 text-slate-400 group-open:rotate-180 transition-transform" />
      </summary>
      <div class="px-4 pb-4 text-slate-600 border-t border-slate-200 pt-3">{item.answer}</div>
    </details>
  ))}
</div>
