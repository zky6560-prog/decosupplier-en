---
interface Industry {
  title: string;
  description: string;
  iconGradient: string;
  iconPath: string;
  features: string[];
}

const industries: Industry[] = [
  {
    title: "15+ Years",
    description: "Deep expertise in PVC film formulation, printing, and embossing — serving global furniture and flooring industries",
    iconGradient: "from-blue-500 to-blue-600",
    iconPath: "M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z",
    features: [
      "Continuous technical accumulation",
      "Global market insight",
      "Mature supply chain"
    ]
  },
  {
    title: "1000+ Patterns",
    description: "In-stock trendy textures – wood, marble, microcement, and more",
    iconGradient: "from-teal-500 to-teal-600",
    iconPath: "M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6z M14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6z M4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2z M14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z",
    features: [
      "Wood / stone / cement finishes",
      "Yearly trend updates",
      "OEM/ODM pattern development"
    ]
  },
  {
    title: "Factory-Direct Pricing",
    description: "Eliminate 20-40% intermediary markup. You communicate directly with our production team, not trading agents.",
    iconGradient: "from-blue-600 to-teal-600",
    iconPath: "M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4",
    features: [
      "Vertically integrated production",
      "No intermediary markup",
      "Full traceability"
    ]
  },
  {
    title: "50,000+ m² Production Base",
    description: "Modern production base with high-precision printing and automated lines",
    iconGradient: "from-slate-700 to-slate-800",
    iconPath: "M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4",
    features: [
      "Wide-width calendering lines",
      "Smart slitting & packaging",
      "Millions of square metres annual capacity"
    ]
  },
  {
    title: "30+ Export Markets",
    description: "Trusted by distributors and contractors across Middle East, Central Asia, Southeast Asia, South America, Russia, Ukraine, and Africa",
    iconGradient: "from-orange-500 to-orange-600",
    iconPath: "M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z",
    features: [
      "Middle East, Central Asia, Southeast Asia, South America, Russia, Ukraine, Africa",
      "ISO 9001 certified quality system",
      "Dedicated account manager for every client"
    ]
  },
  {
    title: "52 Patents",
    description: "52 granted patents in decorative surface engineering — demonstrating continuous R&D investment and technical leadership",
    iconGradient: "from-purple-500 to-purple-600",
    iconPath: "M18.364 5.636a9 9 0 010 12.728m0 0l-2.829-2.829m2.829 2.829L21 16M9 6a2 2 0 11-4 0 2 2 0 014 0z M5.636 18.364a9 9 0 01-12.728 0m0 0l2.829-2.829m-2.829 2.829L3 16",
    features: [
      "PVC film formulation & embossing technology",
      "Surface wear-resistant coating innovations",
      "Continuous R&D investment & new product development"
    ]
  }
];

const checkmarkPath = "M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z";
---

<section class="py-24 bg-linear-to-b from-slate-50 to-white">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <div class="inline-block px-4 py-2 mb-4 bg-[var(--color-primary-100)] text-[var(--color-primary-800)] text-sm font-semibold rounded-full">
        Why Global Buyers Choose Us
      </div>
      <h2 class="text-4xl md:text-5xl font-bold text-slate-900 mb-6">
        15 Years. 50,000+ m². 1000+ Patterns.
      </h2>
      <p class="text-xl text-slate-600 max-w-3xl mx-auto leading-relaxed">
        Every roll shipped from our factory is backed by ISO-certified processes, three-tier quality inspection, and a dedicated account team — no middlemen, no surprises.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {industries.map((industry) => (
        <div class="group bg-white rounded-2xl p-6 shadow-lg hover:shadow-2xl transition-all hover:-translate-y-1 border border-slate-100">
          <!-- 第一行：图标（变小） + 大标题（左右并排） -->
          <div class="flex items-center gap-3 mb-3">
            <div class={`w-10 h-10 rounded-xl bg-linear-to-br ${industry.iconGradient} flex items-center justify-center shrink-0 group-hover:scale-110 transition-transform`}>
              <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={industry.iconPath} />
              </svg>
            </div>
            <h3 class="text-xl font-bold text-slate-900">{industry.title}</h3>
          </div>

          <!-- 第二行：描述（左对齐） -->
          <p class="text-sm text-slate-600 leading-relaxed mb-3 text-left">
            {industry.description}
          </p>

          <!-- 第三行：特性列表（左对齐） -->
          <ul class="space-y-1.5 text-sm text-slate-600 text-left">
            {industry.features.map((feature) => (
              <li class="flex items-center">
                <svg class="w-4 h-4 text-teal-500 mr-2 shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d={checkmarkPath} clip-rule="evenodd" />
                </svg>
                <span class="text-sm">{feature}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- Bottom CTA -->
    <div class="text-center mt-16">
      <a 
        href="/about" 
        class="inline-flex items-center px-8 py-4 text-base font-semibold text-white bg-linear-to-r from-[var(--color-primary-600)] to-[var(--color-secondary-600)] hover:from-[var(--color-primary-700)] hover:to-[var(--color-secondary-700)] rounded-lg shadow-lg hover:shadow-xl transition-all group"
      >
        See Our Factory & Production Lines
        <svg class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </div>
</section>