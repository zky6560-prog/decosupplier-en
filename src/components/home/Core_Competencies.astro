---
import { Image } from 'astro:assets';
import AnimatedStats from '../react/AnimatedStats';
import logisticsNetworkImg from '@assets/photo-1578575437130-527eed3abbec.jpg';
---

<section class="relative py-24 overflow-hidden">
  <!-- Background -->
  <div class="absolute inset-0">
    <Image 
      src={logisticsNetworkImg}
      alt="DecoSupplier global manufacturing network"
      class="w-full h-full object-cover"
      width={2070}
      height={1380}
    />
    <div class="absolute inset-0 bg-slate-900/90"></div>
  </div>

  <!-- Content -->
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center mb-16">
      <div class="inline-block px-4 py-2 mb-4 bg-white/10 backdrop-blur-sm text-white text-sm font-semibold rounded-full">
        What Makes Us Different
      </div>
      <h2 class="text-4xl md:text-5xl font-bold text-white mb-6">
        Not Just a Supplier — <span class="text-transparent bg-clip-text bg-linear-to-r from-blue-400 to-teal-400">Your Production Partner</span>
      </h2>
      <p class="text-xl text-slate-300 max-w-3xl mx-auto leading-relaxed">
        3 factories. 1000+ print cylinders. 52 patents. 50,000+ m² production base. Talk directly to the factory — from sampling to shipment.
      </p>
    </div>

    <AnimatedStats client:load />

    <!-- Features Section -->
    <div class="mt-20 grid grid-cols-1 md:grid-cols-3 gap-8 max-w-5xl mx-auto">
      <div class="backdrop-blur-sm bg-white/5 hover:bg-white/10 rounded-xl p-8 transition-all border border-white/10 hover:border-white/20 group text-center">
        <div class="w-16 h-16 rounded-xl bg-blue-100/20 flex items-center justify-center mx-auto mb-4 group-hover:scale-110 transition-transform">
          <svg class="w-8 h-8 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
          </svg>
        </div>
        <h3 class="text-xl font-bold text-white mb-3">Factory-Direct Communication</h3>
        <p class="text-slate-300 leading-relaxed">Skip the trading agent. Your project requirements go straight to our production manager — faster response, accurate quoting, no information loss.</p>
      </div>

      <div class="backdrop-blur-sm bg-white/5 hover:bg-white/10 rounded-xl p-8 transition-all border border-white/10 hover:border-white/20 group text-center">
        <div class="w-16 h-16 rounded-xl bg-teal-100/20 flex items-center justify-center mx-auto mb-4 group-hover:scale-110 transition-transform">
          <svg class="w-8 h-8 text-teal-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
          </svg>
        </div>
        <h3 class="text-xl font-bold text-white mb-3">OEM/ODM — Your Design, Our Production</h3>
        <p class="text-slate-300 leading-relaxed">Send us your design file or physical sample. We'll match the color, texture, and finish — cylinder engraving costs are deductible from your bulk order.</p>
      </div>

      <div class="backdrop-blur-sm bg-white/5 hover:bg-white/10 rounded-xl p-8 transition-all border border-white/10 hover:border-white/20 group text-center">
        <div class="w-16 h-16 rounded-xl bg-blue-100/20 flex items-center justify-center mx-auto mb-4 group-hover:scale-110 transition-transform">
          <svg class="w-8 h-8 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
        </div>
        <h3 class="text-xl font-bold text-white mb-3">3-Tier Quality Control, Zero Compromise</h3>
        <p class="text-slate-300 leading-relaxed">Raw material → In-line → Pre-shipment. Every batch tested for scratch resistance, colorfastness, and VOC emissions. Test reports shared with you.</p>
      </div>
    </div>
  </div>
</section>