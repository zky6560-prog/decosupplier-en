---
import FeatureShowcase from '../react/FeatureShowcase';
---

<section class="py-24 bg-slate-50 dark:bg-slate-900/50">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <!-- 1. 小胶囊标签：使用 CSS 原生变量 + 透明度，100% 保证显示浅色底色 -->
      <div 
        class="inline-block px-4 py-2 mb-4 text-sm font-semibold rounded-full border border-[var(--color-secondary-500)]/20"
        style="background-color: var(--color-secondary-light); color: var(--color-secondary-dark);"
      >
        Our Products
      </div>
      
      <!-- 2. 高亮标题：使用全局 gradient-text -->
      <h2 class="text-4xl md:text-5xl font-bold text-slate-900 dark:text-white mb-6">
        7 Product Lines, One Factory
      </h2>
      
      <!-- 3. 副标题 -->
      <p class="text-xl text-slate-600 dark:text-slate-300 max-w-3xl mx-auto leading-relaxed">
        From furniture films to flooring and wall panels — all from one factory. OEM/ODM available. Low MOQ.
      </p>
    </div>

    <FeatureShowcase client:load />
    
    <!-- 4. 底部 CTA 按钮：改用全局 gradient-text 对应的颜色风格或主题色 -->
    <div class="text-center mt-16">
      <a 
        href="/products" 
        class="inline-flex items-center px-8 py-4 text-base font-semibold text-slate-950 bg-[var(--color-secondary-500)] hover:bg-[var(--color-secondary-600)] rounded-lg shadow-lg hover:shadow-xl transition-all group"
      >
        View All Products & Get Samples
        <svg class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </div>
</section>